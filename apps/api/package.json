{
	"name": "@jortemplate/api",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"start": "NODE_ENV=production bun run src/index.ts",
		"typecheck": "bunx tsc --noEmit",
		"lint": "biome lint --error-on-warnings .",
		"format": "biome format --write .",
		"check": "biome check --error-on-warnings .",
		"check:fix": "biome check --write --error-on-warnings .",
		"ci": "bun run check && bun run typecheck",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:prod": "bun run src/db/migrate.ts",
		"db:seed": "bun run src/db/seed/seed.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1146.0",
		"@jortemplate/utils": "workspace:*",
		"dotenv": "^17.2.2",
		"drizzle-orm": "^0.45.3",
		"file-type": "^22.1.1",
		"hono": "^4.13.3",
		"postgres": "^3.4.9",
		"zod": "^4.1.5",
		"@jortemplate/types": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "latest",
		"drizzle-kit": "^0.31.11",
		"typescript": "^5.9.2"
	}
}
